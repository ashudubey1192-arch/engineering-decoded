{
  "id": "stock-fee",
  "title": "Stock DP: Unlimited Transactions with a Fee",
  "contract": "Nonnegative prices and fee. Hold at most one share, pay the fee when selling, and return maximum realized profit.",
  "signature": "long solve(int[] prices,int fee)",
  "brute": "return stock(prices,fee,0,false);",
  "optimal": "long cash=0,hold=-INF;for(int price:prices){long oldCash=cash;cash=Math.max(cash,hold+price-fee);hold=Math.max(hold,oldCash-price);emit(\"Update sell/hold states from the previous day\",\"price\",price,\"cash\",cash,\"hold\",hold);}return cash;",
  "reasoning": [
    "Enumerate holding or not holding at each day with buy, sell, or wait actions; ending with a share is invalid.",
    "cash is best profit with no share and hold is best profit with one share after the day.",
    "Update from old states to keep transitions consistent. Charge the fee exactly once per transaction. Return cash, since unsold inventory is not realized profit."
  ],
  "complexity": [
    "O(2ⁿ), O(n)",
    "O(n), O(1)"
  ],
  "tests": [
    {
      "label": "Fee",
      "args": "new int[]{1,3,2,8,4,9},2",
      "expected": "8"
    },
    {
      "label": "Falling",
      "args": "new int[]{5,4,3},1",
      "expected": "0"
    }
  ],
  "slug": "problems--stock-fee",
  "sectionSlug": "problems",
  "time": "25 min",
