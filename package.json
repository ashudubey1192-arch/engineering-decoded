{
  "name": "engineering-decoded",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:core-cs && npm run check:tutorials && npm run check:ai-engineering && vite build",
    "check:tutorials": "node scripts/check-tutorials.mjs",
    "check:interview-courses": "node scripts/check-interview-courses.mjs",
    "check:lesson-depth": "node scripts/audit-lesson-depth.mjs",
    "test:workshop": "node --test tests/workshop.test.mjs",
    "check:core-cs": "node --test tests/core-cs-roadmaps.test.mjs && node scripts/check-core-cs-roadmaps.mjs",
    "generate:system-design": "node scripts/build-system-design-quizzes.mjs",
    "check:system-design": "node scripts/check-system-design-quizzes.mjs",
    "check:dsa-concepts": "node scripts/check-dsa-concept-quizzes.mjs",
    "generate:pattern-quizzes": "node scripts/build-pattern-quizzes.mjs",
    "check:pattern-interactivity": "node scripts/check-pattern-interactivity.mjs",
    "check:ai-interactivity": "node scripts/check-ai-interactivity.mjs",
    "generate:ai-engineering": "node scripts/build-ai-engineering.mjs",
    "check:ai-engineering": "node scripts/check-ai-engineering.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "check:databases": "node scripts/check-database-courses.mjs",
    "check:dsa": "node scripts/check-dsa-courses.mjs",
    "check:dsa-practice": "node scripts/check-dsa-practice.mjs",
    "check:dsa-java": "node scripts/check-dsa-java.mjs",
    "check:dsa-sync": "node scripts/check-dsa-sync.mjs",
    "generate:java-networks": "node scripts/generate-java-networks.mjs",
    "check:java-networks": "node scripts/check-java-networks.mjs",
    "check:java-techniques": "node scripts/check-java-techniques.mjs",
    "generate:java-arrays": "node scripts/generate-java-arrays.mjs",
    "check:java-arrays": "node scripts/generate-java-arrays.mjs --check",
    "generate:patterns": "node scripts/build-pattern-lessons.mjs",
    "check:patterns": "node scripts/build-pattern-lessons.mjs --check && node scripts/check-pattern-routes.mjs",
    "generate:social": "node scripts/generate-social-courses.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-neon.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:auth": "node --test tests/sign-in.test.mjs tests/sdk-token.test.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "jose": "6.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  }
}
