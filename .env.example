# Server only: use the Neon pooled connection string. Never prefix this with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Copy the Neon Auth endpoint for the same branch used by DATABASE_URL.
VITE_NEON_AUTH_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# JWT verification values from your Neon Auth token configuration.
NEON_AUTH_JWKS_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=YOUR_NEON_AUTH_JWT_ISSUER
NEON_AUTH_AUDIENCE=YOUR_NEON_AUTH_JWT_AUDIENCE
# Enable Email OTP, Google, and GitHub in the Neon Auth console.
# OAuth client secrets belong in Neon Auth, never in VITE_* variables.
# Optional external isolated Java runner; server only.
JAVA_RUNNER_URL=
JAVA_RUNNER_TOKEN=
